<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-app</artifactId>
    <version>4.0.0</version>
    <packaging>jar</packaging>

    <name>Hitorro Application Runner</name>
    <description>Main application module that aggregates all Hitorro components for running applications</description>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <hitorro.version>4.0.0</hitorro.version>
    </properties>

    <!-- Jackson 2 only arrives through third parties (Solr via hitorro-objretrieval); pin it as the libraries do. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-streams</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-basefile</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- Include all Hitorro modules -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-util</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-base</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-unittime</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-features</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-jsonsql</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-objretrieval</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-text-core</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-text-persistence</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-basedms</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-dedupe</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-analysis</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-logdigest</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-dataaquisition</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-conversation</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-baseui</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-test</artifactId>
            <version>${hitorro.version}</version>
        </dependency>

        <!-- Runtime dependencies -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.7.0</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>com.hitorro.util.cmdline.CommandLine</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <name>Hitorro Local Maven Repository</name>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
        <snapshotRepository>
            <id>hitorro-local-snapshots</id>
            <name>Hitorro Local Maven Snapshot Repository</name>
            <url>file://${hitorro.deploy.repo.path}</url>
        </snapshotRepository>
    </distributionManagement>

</project>
